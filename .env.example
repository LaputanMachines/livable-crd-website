# Template for the local .env, which is gitignored. Copy and fill in:
#
#   cp .env.example .env
#   source .env
#
# Never commit the filled-in version. The candidate sheet's export URL is a
# capability: anyone with it can read the whole tracking sheet, including
# contact details and the subjective columns the site never publishes. CI holds
# the same value as the CANDIDATES_CSV_URL repo secret.

# CSV export of the coalition candidate-tracking sheet. Take the sheet id from
# its URL and point gid at the tab holding the candidate rows:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
export CANDIDATES_CSV_URL=""

# Used only by scripts/questionnaire/ (committee tooling, run locally with
# gspread + interactive Google auth). Just the sheet id, not a URL.
export QUESTIONNAIRE_SHEET_ID=""

# Tally's raw submission sheet for the candidate questionnaire, used by
# scripts/questionnaire/grading_tabs.py and by scripts/sync-questionnaire.py.
# Just the sheet id, not a URL. A different sheet from QUESTIONNAIRE_SHEET_ID:
# this one holds candidate answers, names and email addresses. CI holds the same
# value as the QUESTIONNAIRE_SUBMISSIONS_SHEET_ID repo secret.
export QUESTIONNAIRE_SUBMISSIONS_SHEET_ID=""

# Google service-account key, as the JSON itself rather than a path to it. Only
# scripts/sync-questionnaire.py reads it, and only to run unattended: left
# blank, that script falls back to the same interactive Google auth every other
# script here uses, which is what you want locally. CI holds the same value as
# the GOOGLE_SERVICE_ACCOUNT_JSON repo secret.
#
# The account it belongs to can read the whole submissions sheet, candidate
# email addresses included, so this is a credential and not a setting. To
# withdraw it, revoke the key in Google Cloud rather than un-sharing the sheet.
export GOOGLE_SERVICE_ACCOUNT_JSON=""
