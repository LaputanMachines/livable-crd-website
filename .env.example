# Template for the local .env, which is gitignored. Copy and fill in:
#
#   cp .env.example .env
#   source .env
#
# Never commit the filled-in version. The candidate sheet's export URL is a
# capability: anyone with it can read the whole tracking sheet, including
# contact details and the subjective columns the site never publishes. CI holds
# the same value as the CANDIDATES_CSV_URL repo secret.

# CSV export of the coalition candidate-tracking sheet. Take the sheet id from
# its URL and point gid at the tab holding the candidate rows:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
export CANDIDATES_CSV_URL=""

# Used only by scripts/questionnaire/ (committee tooling, run locally with
# gspread + interactive Google auth). Just the sheet id, not a URL.
export QUESTIONNAIRE_SHEET_ID=""

# Tally's raw submission sheet for the candidate questionnaire, used by
# scripts/questionnaire/grading_tabs.py. Just the sheet id, not a URL. A
# different sheet from QUESTIONNAIRE_SHEET_ID: this one holds candidate answers,
# names and email addresses.
export QUESTIONNAIRE_SUBMISSIONS_SHEET_ID=""
