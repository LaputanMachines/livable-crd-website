# Template for the local .env, which is gitignored. Copy and fill in:
#
#   cp .env.example .env
#   source .env
#
# Never commit the filled-in version. The candidate sheet's export URL is a
# capability: anyone with it can read the whole tracking sheet, including
# contact details and the subjective columns the site never publishes. CI holds
# the same value as the CANDIDATES_CSV_URL repo secret.

# CSV export of the coalition candidate-tracking sheet. Take the sheet id from
# its URL and point gid at the tab holding the candidate rows:
#   https://docs.google.com/spreadsheets/d/<SHEET_ID>/export?format=csv&gid=<GID>
export CANDIDATES_CSV_URL=""

# Used only by scripts/questionnaire/ (committee tooling, run locally with
# gspread + interactive Google auth). Just the sheet id, not a URL.
export QUESTIONNAIRE_SHEET_ID=""

# Tally's raw submission sheet for the candidate questionnaire, used by
# scripts/questionnaire/grading_tabs.py and by scripts/sync-questionnaire.py.
# Just the sheet id, not a URL. A different sheet from QUESTIONNAIRE_SHEET_ID:
# this one holds candidate answers, names and email addresses. CI holds the same
# value as the QUESTIONNAIRE_SUBMISSIONS_SHEET_ID repo secret.
export QUESTIONNAIRE_SUBMISSIONS_SHEET_ID=""

# The Tally questionnaire form itself, read by scripts/sync-questionnaire.py for
# the answer choices /questionnaire/ publishes under each question. The
# spreadsheet cannot supply these: it names a multi-select's options in its
# column headers, but a single-choice question exports as one column holding
# whichever answer came back.
#
# The key is a capability over the whole Tally workspace — every form, every
# submission — so treat it like the sheet ids above and keep it out of git. CI
# holds both as the TALLY_FORM_ID and TALLY_API_KEY repo secrets. Without them
# the sync still runs and warns; only the answer choices are affected.
export TALLY_FORM_ID=""
export TALLY_API_KEY=""

# Google service account key (the whole downloaded JSON, on one line), used only
# by scripts/mark-questionnaire-complete.py to tick the tracking sheet's
# "Completed Questionnaire" column. Everything else in scripts/ only reads, over
# plain HTTP, and needs no credentials at all.
#
# Create the account, share the candidate-tracking spreadsheet with its email
# address as an Editor, and paste its JSON key here. It is scoped to Sheets and
# is the only credential in this file that can change a spreadsheet, so it is
# the one worth being most careful with. CI holds the same value as the
# GOOGLE_SERVICE_ACCOUNT_JSON repo secret. Leave it empty to run the script with
# --dry-run, which reports what it would tick and needs no key.
export GOOGLE_SERVICE_ACCOUNT_JSON=""
